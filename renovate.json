{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 5,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Rust crates (patch)",
      "automerge": true,
      "automergeType": "pr",
      "description": "Patch bumps are in-range for Cargo and gated on CI (build + build-macos + build-windows + fast test tier)."
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "description": "Minor bumps automerge on green CI. NOTE: for a 0.x crate, Cargo treats a minor bump (e.g. 0.12 -> 0.13) as BREAKING, so these rely on CI catching the break. If a 0.x minor ever lands something CI cannot see, tighten this to patch-only or add matchCurrentVersion: '>=1.0.0'."
    },
    {
      "matchManagers": ["devbox"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "groupName": "Devbox packages",
      "labels": ["dependencies", "devbox"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["site/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Docs site (site/)",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackageNames": ["crossterm", "futures-util", "insta"],
      "automerge": false,
      "labels": ["dependencies", "manual-review"],
      "description": "Deliberate EXACT pins in Cargo.toml, never automerged. crossterm's pin is load-bearing: `ui::ctrl_c0_byte` documents crossterm 0.28.1's decoder behaviour and `keyevent_ctrl_c0_matches_crossterm_decoder` guards it (PRD #227). See also #242 (crossterm 0.28.1 + 0.29.0 coexist because ratatui 0.30 pulls 0.29 via ratatui-crossterm)."
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "manual-review"],
      "description": "Major bumps always stay manual."
    }
  ]
}
